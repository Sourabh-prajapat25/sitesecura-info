# SiteSecura Informational Website Configuration
# Copy this file to .env.local to override default URLs if needed

# Primary Informational Website URL
NEXT_PUBLIC_SITE_URL="https://sitesecura.info"

# Main SaaS Product Platform URL
NEXT_PUBLIC_PLATFORM_URL="https://sitesecura.com"

# External Application Form URL (e.g., Google Form for recruitment / general interest)
# Leave empty to use the graceful internal fallback with mailto/contact route
NEXT_PUBLIC_APPLICATION_FORM_URL=""

# Specific Track Application Form URLs (optional overrides)
NEXT_PUBLIC_INTERNSHIP_FORM_URL=""
NEXT_PUBLIC_CAREERS_FORM_URL=""

# Contact Email Addresses (Set when officially verified; fallback guidance used if empty)
NEXT_PUBLIC_CONTACT_EMAIL="contact@sitesecura.com"
NEXT_PUBLIC_CAREERS_EMAIL="careers@sitesecura.com"
NEXT_PUBLIC_SECURITY_EMAIL="security@sitesecura.com"
