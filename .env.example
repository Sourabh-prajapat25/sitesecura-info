# ==============================================================================
# SiteSecura Production Configuration (.env.example)
# Copy this file to .env.local for local development. Never commit real secrets.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Public Website & SaaS Platform URLs
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="https://sitesecura.info"
NEXT_PUBLIC_PLATFORM_URL="https://sitesecura.com"
SITE_URL="https://sitesecura.info"

# ------------------------------------------------------------------------------
# 2. Public Application & Contact URLs (Informational Portal)
# ------------------------------------------------------------------------------
# External recruitment form URL (e.g. Google Form). Leave empty for mailto fallback.
NEXT_PUBLIC_APPLICATION_FORM_URL=""
NEXT_PUBLIC_INTERNSHIP_FORM_URL=""
NEXT_PUBLIC_CAREERS_FORM_URL=""

NEXT_PUBLIC_CONTACT_EMAIL="contact@sitesecura.com"
NEXT_PUBLIC_CAREERS_EMAIL="careers@sitesecura.com"
NEXT_PUBLIC_SECURITY_EMAIL="security@sitesecura.com"

# ------------------------------------------------------------------------------
# 3. HR Administration & Security Authentication (Server-Only, No NEXT_PUBLIC_)
# ------------------------------------------------------------------------------
# Storage mode:
# - "production": Mandatory durable persistent storage via Google Sheets & Drive.
#                 Never silently falls back to ephemeral disk on Vercel.
# - "development": Allows local disk fallback (.data/interns.json) when Google APIs are unconfigured.
# - "test": In-memory isolated storage for test runners.
STORAGE_MODE="production"

# Shared HR administrative passkey for HR Portal authentication
HR_PORTAL_PASSKEY="ChangeThisToAStrongSecurePasskey2026!"

# Secret used to sign HttpOnly HMAC SHA-256 session cookies (min 32 characters)
HR_SESSION_SECRET="generate-a-strong-random-32-character-secret-key-here"

# ------------------------------------------------------------------------------
# 4. Google Cloud Service Account Integration (Sheets Register & Drive Storage)
# ------------------------------------------------------------------------------
# Google Cloud Service Account Email with Editor access to Sheet and Folders
GOOGLE_SERVICE_ACCOUNT_EMAIL="sitesecura-hr-service@your-gcp-project.iam.gserviceaccount.com"

# Service Account Private Key (In Vercel/env, keep literal \n or wrap in double quotes)
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# ID of the private Google Spreadsheet (contains worksheet "Interns")
GOOGLE_SHEET_ID="your_google_sheet_id_here"

# Google Drive Folder IDs for private document archiving
GOOGLE_DRIVE_RESUME_FOLDER_ID="your_google_drive_resume_folder_id_here"
GOOGLE_DRIVE_CERTIFICATE_FOLDER_ID="your_google_drive_certificate_folder_id_here"

# ------------------------------------------------------------------------------
# 5. Certificate Issuance Signatory Configuration
# ------------------------------------------------------------------------------
CERTIFICATE_SIGNATORY_NAME="Sourabh K."
CERTIFICATE_SIGNATORY_TITLE="Director, People & Operations"
